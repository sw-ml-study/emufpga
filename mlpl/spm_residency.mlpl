# What actually has to be in RAM.
#
# The whole point of the Serial Parameter Machine, as one ratio.
# Numbers are measured, from docs/results.md saga 2 steps 9 and 11:
# SmolLM2-135M at bf16, five clients, on a real checkpoint.
#
#   mlpl-repl -f mlpl/spm_residency.mlpl

# Parameter residency: Rp = resident parameter bytes / total.
weights_total = 269564308      # the .spm on disk, bf16
weights_resident = 4096        # one group buffer -- the ONLY weights in RAM

print("weight bytes on disk")
print(weights_total)
print("weight bytes resident")
print(weights_resident)

# A conventional engine must hold every weight before it can use any,
# because it will ask for them in an input-dependent order. Rp = 1.
print("Rp conventional (all weights resident)")
print(1)
print("Rp streamed")
print(weights_resident / weights_total)
print("times fewer resident weight bytes")
print(weights_total / weights_resident)

# The bar makes the ratio visible in a way the number does not.
svg([weights_total, weights_resident], "bar")

# ---------------------------------------------------------------- 2
# Where each thing lives, in both designs.
#
# The contrast is not "less memory". It is that the weights move to a
# different KIND of memory, and only the small things stay fast.

# Edge labels stay under 12 characters and no group spans two layers.
# The renderer centres an edge label in a 96px column gap at 8px per
# character, and draws a group band across every layer its members
# occupy -- so a long label lands on the boxes, and a group whose
# members sit at different depths overlaps another group's band.

conventional = { labels: ["disk", "VRAM 269 MB", "compute"] }
conventional_edges = {
  from: [0, 1], to: [1, 2],
  labels: ["load all", "random"],
  widths: [269564308, 269564308],
  width_scale: "log"
}
print("conventional: everything resident before anything runs")
dataflow(conventional, conventional_edges)

streamed = {
  labels: ["store 269 MB", "RAM 0.7 MB", "buffer 4 KiB", "compute"],
  highlight: [0, 0, 1, 0]
}
streamed_edges = {
  from: [0, 2, 1], to: [2, 3, 3],
  labels: ["stream", "apply", "resident"],
  # Real byte counts, not hand-picked stroke widths. A 65,000:1 ratio
  # cannot be drawn linearly -- the thin edge vanishes or the thick
  # one becomes a blob -- so the log scale is what makes the honest
  # numbers renderable at all.
  widths: [269564308, 4096, 700000],
  width_scale: "log",
  highlight: [1, 1, 0]
}
print("streamed: the weights never land")
dataflow(streamed, streamed_edges)

# ---------------------------------------------------------------- 3
# The bill that does NOT go away.
#
# A KV cache is per conversation: written as generation proceeds, read
# on every later token, growing with clients and context. It cannot be
# streamed, and it is the real memory cost of this design.
#
# For a 300 GB mixture-of-experts model with compressed attention
# state (docs/why-this-saves-ram.md), in gigabytes:

clients = [1, 5, 20]
kv_gb = [0.29, 1.44, 5.76]
print("clients")
print(clients)
print("KV cache GB, weights resident ~0")
print(kv_gb)
svg(kv_gb, "bar")

# 300 GB of model against about 1.4 GB of RAM at five clients. That is
# the whole thesis in two numbers, and the KV cache -- not the weights
# -- is what now sets the limit.
