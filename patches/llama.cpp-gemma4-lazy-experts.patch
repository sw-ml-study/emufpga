diff --git a/ggml/include/ggml-cpu.h b/ggml/include/ggml-cpu.h
--- a/ggml/include/ggml-cpu.h
+++ b/ggml/include/ggml-cpu.h
@@ -29,6 +29,23 @@ extern "C" {
         GGML_NUMA_STRATEGY_COUNT
     };
 
+    // Experimental selected-expert backing-store boundary. Install callbacks
+    // before graph execution starts and keep them installed until all graphs
+    // finish. Each CPU worker acquires its own lease; release occurs only after
+    // every worker has crossed the expert-completion barrier.
+    struct ggml_mmid_span {
+        const void * data;
+        void * lease;
+    };
+    typedef bool (*ggml_mmid_span_acquire_t)(const struct ggml_tensor * tensor,
+            int64_t expert, size_t bytes, struct ggml_mmid_span * span, void * user_data);
+    typedef void (*ggml_mmid_span_release_t)(struct ggml_mmid_span * span, void * user_data);
+
+    GGML_BACKEND_API void ggml_cpu_set_mmid_span_provider(
+            ggml_mmid_span_acquire_t acquire,
+            ggml_mmid_span_release_t release,
+            void * user_data);
+
     GGML_BACKEND_API void    ggml_numa_init(enum ggml_numa_strategy numa); // call once for better performance on NUMA systems
     GGML_BACKEND_API bool    ggml_is_numa(void); // true if init detected that system has >1 NUMA node

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -35,6 +35,10 @@
 #include <syscall.h>
 #endif
 
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+static ggml_mmid_span_acquire_t g_mmid_span_acquire = NULL;
+static ggml_mmid_span_release_t g_mmid_span_release = NULL;
+static void * g_mmid_span_user_data = NULL;
+
+void ggml_cpu_set_mmid_span_provider(
+        ggml_mmid_span_acquire_t acquire,
+        ggml_mmid_span_release_t release,
+        void * user_data) {
+    GGML_ASSERT((acquire == NULL) == (release == NULL));
+    g_mmid_span_acquire = acquire;
+    g_mmid_span_release = release;
+    g_mmid_span_user_data = user_data;
+}
+
 #ifdef GGML_USE_OPENMP
 #include <omp.h>
 #endif
@@ -1663,6 +1667,17 @@ static void ggml_compute_forward_mul_mat_id(
 
     ggml_barrier(params->threadpool);
 
+    if (ith == 0 && getenv("GGML_MUL_MAT_ID_TRACE") != NULL) {
+        int64_t selected = 0;
+        for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+            selected += matrix_row_counts[cur_a] != 0;
+        }
+        struct timespec now;
+        clock_gettime(CLOCK_REALTIME, &now);
+        const double timestamp_s = now.tv_sec + now.tv_nsec / 1e9;
+        fprintf(stderr,
+                "spm_mmid timestamp_s=%.9f tensor=%s activations=%" PRId64 " assignments=%" PRId64 " selected=%" PRId64 " expert_bytes=%zu logical_bytes=%zu\n",
+                timestamp_s, src0->name, ids->ne[1], ids->ne[1] * n_ids, selected, nb02, (size_t) selected * nb02);
+        fprintf(stderr, "spm_mmid_experts timestamp_s=%.9f tensor=%s counts=", timestamp_s, src0->name);
+        int printed = 0;
+        for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+            if (matrix_row_counts[cur_a] != 0) {
+                fprintf(stderr, "%s%d:%" PRId64, printed++ == 0 ? "" : ",", cur_a, matrix_row_counts[cur_a]);
+            }
+        }
+        fputc('\n', stderr);
+    }
+
     for (int cur_a = 0; cur_a < n_as; ++cur_a) {
         const int64_t cne1 = matrix_row_counts[cur_a];
 
@@ -1670,15 +1685,16 @@ static void ggml_compute_forward_mul_mat_id(
             continue;
         }
 
+        const char * src0_cur = (const char *) src0->data + cur_a * nb02;
+        struct ggml_mmid_span expert_span = { src0_cur, NULL };
+        if (g_mmid_span_acquire != NULL) {
+            GGML_ASSERT(g_mmid_span_acquire(src0, cur_a, nb02, &expert_span, g_mmid_span_user_data));
+            GGML_ASSERT(expert_span.data != NULL);
+            src0_cur = expert_span.data;
+        }
+#if defined(__linux__)
+        if (getenv("GGML_MUL_MAT_ID_DONTNEED") != NULL) {
+            if (ith == 0) {
+                const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+                const uintptr_t begin = ((uintptr_t) src0_cur + page - 1) & ~(page - 1);
+                const uintptr_t end = ((uintptr_t) src0_cur + nb02) & ~(page - 1);
+                if (begin < end) {
+                    madvise((void *) begin, end - begin, MADV_RANDOM);
+                }
+            }
+            ggml_barrier(params->threadpool);
+        }
+#endif
+
         if (iqp && ggml_cpu_iqp_mul_mat_id_min_batch(cne1)) {
             ggml_compute_forward_mul_mat_id_iqp(params, dst, cur_a, cne1, (const int32_t *) &MMID_MATRIX_ROW(cur_a, 0),
                                                 iqp_panels);
 
-            continue;
+            goto release_expert;
         }
 
-        const char * src0_cur = (const char *) src0->data + cur_a * nb02;
         const void * wdata = (src1->type == vec_dot_type) ? src1->data : params->wdata;
         const size_t row_size = ggml_row_size(vec_dot_type, ne10);
 
@@ -1733,6 +1738,24 @@ static void ggml_compute_forward_mul_mat_id(
 
             current_chunk = atomic_fetch_add_explicit(current_chunk_ctr, 1, memory_order_relaxed);
         }
+
+release_expert:;
+        // The acquired bytes remain leased until every CPU worker has
+        // completed this expert. Providers may evict only after release.
+        ggml_barrier(params->threadpool);
+#if defined(__linux__)
+        // Experimental bounded-residency mode for read-only mmap-backed expert
+        // tensors. All workers finish this expert before its interior pages are
+        // made immediately reclaimable. Boundary pages remain mapped so this
+        // never discards bytes belonging to an adjacent expert.
+        if (ith == 0 && getenv("GGML_MUL_MAT_ID_DONTNEED") != NULL) {
+            const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+            const uintptr_t begin = ((uintptr_t) src0_cur + page - 1) & ~(page - 1);
+            const uintptr_t end = ((uintptr_t) src0_cur + nb02) & ~(page - 1);
+            const char * keep = getenv("GGML_MUL_MAT_ID_KEEP");
+            int layer = -1;
+            char key[48];
+            sscanf(src0->name, "blk.%d.", &layer);
+            snprintf(key, sizeof(key), "|%d:%d|", layer, cur_a);
+            const int retained = keep != NULL && strstr(keep, key) != NULL;
+            static _Atomic uint64_t retained_count = 0;
+            static _Atomic uint64_t reclaimed_count = 0;
+            const uint64_t decisions = retained
+                ? atomic_fetch_add_explicit(&retained_count, 1, memory_order_relaxed) + 1
+                : atomic_fetch_add_explicit(&reclaimed_count, 1, memory_order_relaxed) + 1;
+            if (getenv("GGML_MUL_MAT_ID_TRACE") != NULL && (decisions == 1 || decisions % 4096 == 0)) {
+                fprintf(stderr, "spm_mmid_residency policy=%s tensor=%s expert=%d bytes=%zu decisions=%" PRIu64 "\n",
+                        retained ? "retain" : "reclaim", src0->name, cur_a, nb02, decisions);
+            }
+            if (!retained && begin < end && madvise((void *) begin, end - begin, MADV_DONTNEED) != 0) {
+                fprintf(stderr, "warning: expert MADV_DONTNEED failed: %s\n", strerror(errno));
+            }
+        }
+        ggml_barrier(params->threadpool);
+#endif
+        if (g_mmid_span_release != NULL) {
+            g_mmid_span_release(&expert_span, g_mmid_span_user_data);
+        }
     }
 }
 
