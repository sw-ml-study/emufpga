# Consumption order for yagizdevre/trm-maze-30x30.
#
# Read from the checkpoint's own trm.py, not guessed. A forward pass is
# H_cycles * (L_cycles + 1) = 3 * 5 = 15 L_level calls, and each call
# sweeps the eight matrices below in exactly this order:
#
#   L_level(hidden, injection):
#     hidden = hidden + injection
#     for layer in layers:                        # 2 of them
#       hidden = rms_norm(hidden + self_attn(hidden))
#       hidden = rms_norm(hidden + mlp(hidden))
#
# At halt_max_steps 16 that is up to 240 sweeps per puzzle. The same
# 6,815,744 weights, read over and over -- which is the rotating
# parameter store from docs/research.txt, arriving for free because
# TRM is recursive.
#
# [rotating] MUST COME FIRST. rewind() returns to the start of the
# stream, so the region that gets rewound has to begin there. Anything
# ahead of it would be re-read on every sweep for nothing.
#
# [resident] is read once and kept in RAM. It is 8,706 weights, 0.13%
# of the model -- embeddings, init vectors and output heads. Streaming
# them would be silly: docs/plan.md section 3 puts small state in
# ordinary memory on purpose, and only the parameter bulk is
# restricted.

[rotating]
_orig_mod.model.inner.L_level.layers.0.self_attn.qkv_proj.weight
_orig_mod.model.inner.L_level.layers.0.self_attn.o_proj.weight
_orig_mod.model.inner.L_level.layers.0.mlp.gate_up_proj.weight
_orig_mod.model.inner.L_level.layers.0.mlp.down_proj.weight
_orig_mod.model.inner.L_level.layers.1.self_attn.qkv_proj.weight
_orig_mod.model.inner.L_level.layers.1.self_attn.o_proj.weight
_orig_mod.model.inner.L_level.layers.1.mlp.gate_up_proj.weight
_orig_mod.model.inner.L_level.layers.1.mlp.down_proj.weight

[resident]
_orig_mod.model.inner.H_init
_orig_mod.model.inner.L_init
_orig_mod.model.inner.embed_tokens.embedding_weight
_orig_mod.model.inner.puzzle_emb.weights
_orig_mod.model.inner.lm_head.weight
_orig_mod.model.inner.q_head.weight
_orig_mod.model.inner.q_head.bias
