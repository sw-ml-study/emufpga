# THE SERIAL PARAMETER MACHINE, IN ONE FILE
#
# Paste into the MLPL playground and run. Self-contained: no data
# files, no downloads. Every number is either computed here or
# measured on a real model in ../emufpga (docs/results.md).
#
# The claim: model weights do not need to be in RAM. They need to go
# PAST the compute, once, in order. Nothing here is about going
# faster. It is about doing the same work, correctly, with far less
# memory and much cheaper storage.
#
# Six sections. Each ends in either a difference that must be zero, or
# a picture.

print("=== 1. Same arithmetic, different memory contract ===")

# W is [output, input] -- the mathematical view, the one every
# framework stores. Computing y = W x needs the whole matrix
# addressable at once.
W = reshape([1,0,-1,1,  0,1,1,-1,  -1,1,0,1], [3, 4])
x = reshape([4,7,2,3], [4, 1])
y_ram = reshape(matmul(W, x), [3])
print("y = W x, conventional (random access)")
print(y_ram)

# ONE TRANSPOSE IS THE ARCHITECTURAL CHANGE.
# S is [input, output]. Row i holds every weight that activation i
# touches -- so the matrix can be consumed by walking rows forward,
# never asking for an address.
S = transpose(W)
print("S = transpose(W), the physical consumption order")
print(S)

def u:sweep(S, x, i, acc) {
  "Fold row `i` of the stream into `acc`, scaled by activation `i`, then move to row i+1. The only motion is forward: no row is revisited and no address is computed, which is the entire restriction the architecture imposes."
  if i > 3 {
    acc
  } else {
    u:sweep(S, x, i + 1, acc + at(S, i) * at(x, i))
  }
}

print("y from a forward-only sweep")
print(u:sweep(S, x, 0, [0,0,0]))
print("difference -- MUST BE ZERO")
print(y_ram - u:sweep(S, x, 0, [0,0,0]))

print("=== 2. Ternary: the stream is an instruction stream ===")

# +1 -> ADD the activation, -1 -> SUBTRACT it, 0 -> BYPASS.
# No multiplier is involved anywhere below. This is why the target
# fabric is decode / add-sub / accumulate rather than a multiplier
# array, and why 2-bit weights suit an FPGA that has many LUTs and
# few DSP blocks.
pos = eq(S, 1)
neg = eq(S, -1)
print("ADD mask")
print(pos)
print("SUB mask")
print(neg)

def u:sweep_ternary(pos, neg, x, i, acc) {
  "The same sweep with no multiply at all: each arriving weight either adds the activation, subtracts it, or is skipped."
  if i > 3 {
    acc
  } else {
    a = at(x, i);
    u:sweep_ternary(pos, neg, x, i + 1, acc + at(pos, i) * a - at(neg, i) * a)
  }
}

print("y from add/subtract only -- no multiplier")
print(u:sweep_ternary(pos, neg, x, 0, [0,0,0]))
print("difference -- MUST BE ZERO")
print(y_ram - u:sweep_ternary(pos, neg, x, 0, [0,0,0]))

print("=== 3. One sweep serves every waiting client ===")

# Three activation vectors -- think three agents asking different
# questions. The weights are identical for all of them; only the
# activations differ. So one pass of the stream serves everyone.
X = reshape([4,7,2,3,  1,0,2,1,  9,9,9,9], [3, 4])

def u:sweep_batch(S, Xt, i, acc) {
  "Fold row `i` of the stream into every client at once. `Xt` is the batch transposed to [input, batch], so one fetched weight vector meets every client's activation before it is discarded. The stream is read exactly once no matter how many clients are waiting."
  if i > 3 {
    acc
  } else {
    row = reshape(at(S, i), [1, 3]);
    col = reshape(at(Xt, i), [3, 1]);
    u:sweep_batch(S, Xt, i + 1, acc + matmul(col, row))
  }
}

Y_spm = u:sweep_batch(S, transpose(X), 0, reshape([0,0,0,0,0,0,0,0,0], [3,3]))
print("Y from ONE sweep serving all three")
print(Y_spm)
print("difference from the conventional batched matmul -- MUST BE ZERO")
print(matmul(X, transpose(W)) - Y_spm)

print("=== 4. What actually has to be in RAM ===")

# Measured on SmolLM2-135M at bf16, a real checkpoint.
weights_total = 269564308      # the model on disk
weights_resident = 4096        # one group buffer -- the ONLY weights in RAM
print("weight bytes on disk, then resident")
print([weights_total, weights_resident])
print("times fewer resident weight bytes")
print(weights_total / weights_resident)

print("=== 5. When is the store the bottleneck? ===")

# Measured: a real serving workload against a bandwidth-limited store.
# Five clients, 2,760 MB of weight traffic over 13 sweeps.
store_mbps  = [500, 258, 200, 150, 100, 50]
wall_s      = [6.908, 10.822, 13.931, 18.542, 27.760, 55.418]
stall_share = [0, 35.5, 49.7, 62.1, 74.3, 87.1]
print("store MB/s")
print(store_mbps)
print("percent of wall clock spent WAITING on the store")
print(stall_share)

# A model that predicts every point: wall = max(compute, bytes/rate).
def u:predict(traffic, compute, rate) {
  "Predicted wall clock: the larger of the time the arithmetic needs and the time the bytes need, because the two overlap and the slower one sets the pace."
  store = traffic / rate;
  if store > compute {
    store
  } else {
    compute
  }
}

def u:predict_all(traffic, compute, rates, i, acc) {
  "Apply the model at every measured store speed."
  if i > 5 {
    acc
  } else {
    u:predict_all(traffic, compute, rates, i + 1,
                  concat(acc, [u:predict(traffic, compute, at(rates, i))]))
  }
}

print("measured minus predicted -- small means the model holds")
print(wall_s - u:predict_all(2760, 6.884, store_mbps, 0, []))
print("the knee: MB/s this engine consumes at")
print(2760 / 6.884)

# THE FINDING. Bytes per sweep are fixed; compute per sweep grows with
# clients. So the bandwidth a store must deliver FALLS as clients
# rise, and the SAME 500 MB/s device is store-bound at one client and
# free at five. Serving more agents makes cheaper storage adequate --
# the opposite of how conventional serving scales.
print("MB/s demanded at 1 client, then at 5")
print([1328, 401])

print("=== 6. Recursion is a back-edge, and re-reading is traffic ===")

# TRM, HRM and BDH apply ONE weight set many times per forward pass.
# In the stream that is a rewind. SmolLM has 30 distinct layers and
# rotates nothing -- its zero is a different architecture, not a small
# number.
models  = ["TRM", "HRM", "BDH", "SmolLM"]
sweeps  = [15, 4, 6, 1]
region  = [27.3, 109.1, 100.7, 212.3]   # working set, MB
traffic = [409, 436, 604, 212]          # moved per forward, MB
print("sweeps per forward")
print(sweeps)
print("working set MB, then traffic MB")
print(region)
print(traffic)

# Re-reading a region does NOT buy work per byte: arithmetic intensity
# is batch/4 MACs per weight-byte for any f32 model read once,
# recursion or not. What recursion buys is a small WORKING SET -- and
# a 27 MB set fits in any machine's RAM, so caching would beat
# streaming for TRM. The case for a serial store is a model too big to
# hold, read once, in order.
def u:reread(traffic, region, i, acc) {
  "Traffic divided by working set: how many times each model re-reads its own region. A ratio of 1 means nothing rotates."
  if i > 3 {
    acc
  } else {
    u:reread(traffic, region, i + 1,
             concat(acc, [at(traffic, i) / at(region, i)]))
  }
}
print("re-reads per forward, recovered from traffic and region")
print(u:reread(traffic, region, 0, []))

print("=== pictures ===")

# Each bare svg/dataflow call renders in the playground.

# Resident bytes, conventional against streamed.
svg([weights_total, weights_resident], "bar")

# Percent of wall clock lost waiting, against store speed.
svg(stall_share, "line")

# Conventional: everything resident before anything runs.
dataflow(
  { labels: ["disk", "VRAM: weights", "VRAM: KV cache", "VRAM: activations", "compute"],
    groups: [0, 1, 1, 1, 2] },
  { from: [0, 1, 2, 3], to: [1, 4, 4, 4],
    labels: ["load ALL, once", "random access", "read", "read"],
    widths: [269564308, 269564308, 700000, 11520],
    width_scale: "log" })

# Streamed: the weights never land. Real byte counts on a log scale --
# 65,000:1 cannot be drawn linearly without lying about one end.
dataflow(
  { labels: ["sequential store: 269 MB", "one group buffer: 4 KiB",
             "RAM: KV cache", "RAM: activations", "compute"],
    groups: [0, 1, 1, 1, 2],
    highlight: [0, 1, 0, 0, 0] },
  { from: [0, 1, 2, 3], to: [1, 4, 4, 4],
    labels: ["stream, forward only", "one group at a time", "read", "read"],
    widths: [269564308, 4096, 700000, 11520],
    width_scale: "log",
    highlight: [1, 1, 0, 0] })

# The rotating store. The rewind is a back-edge, and it draws dashed.
dataflow(
  { labels: ["region start", "sweep the region", "region end", "output head"],
    highlight: [0, 1, 0, 0] },
  { from: [0, 1, 2, 2], to: [1, 2, 0, 3],
    labels: ["read", "consume", "rewind (between calls only)", "read on"],
    widths: [4, 4, 4, 1] })
