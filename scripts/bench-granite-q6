#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
model=${1:-/disk1/tmp/granite-3.1-1b-a400m-q6/granite-3.1-1b-a400m-instruct-Q6_K.gguf}
pattern=1318,18926,432,45600,438,8279,322,43908
tokens=(
    1318
    1318,18926,432,45600
    "$pattern"
    "$pattern,$pattern"
    "$pattern,$pattern,$pattern,$pattern"
)

export SPM_GRANITE_SPM_PATH=${SPM_GRANITE_SPM_PATH:-/disk1/tmp/granite-moe-block0-q6.spm}
export SPM_GRANITE_BLOCK0_ONLY=1
for schedule in all selected; do
    if [[ $schedule == selected ]]; then
        export SPM_GRANITE_SELECTED_UNION=1
    else
        unset SPM_GRANITE_SELECTED_UNION || true
    fi
    for batch in "${tokens[@]}"; do
        "$root/scripts/serial.sh" cargo run --quiet --release \
            --manifest-path "$root/components/cli/Cargo.toml" \
            -p spm-granite-moe -- "$model" "$batch"
    done
done
