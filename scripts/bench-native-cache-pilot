#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
build=${LLAMA_CPP_BUILD_DIR:-/disk1/tmp/llama.cpp-gemma4-lazy-build}
model=${GEMMA4_MODEL:-/disk1/tmp/gemma-4-26b-a4b/google_gemma-4-26B-A4B-it-Q5_K_M.gguf}
tasks=${TASKS:-$root/docs/data/gemma4-rust-cache-combined-v1.json}
budget=${1:?usage: bench-native-cache-pilot CACHE_MIB OUTPUT_DIR [PORT]}
out=${2:?usage: bench-native-cache-pilot CACHE_MIB OUTPUT_DIR [PORT]}
port=${3:-8091}

mkdir -p "$out"
GGML_MMID_CACHE_MIB="$budget" GGML_MMID_CACHE_POLICY=layer \
    "$build/bin/llama-server" -m "$model" -ngl 0 -c 4096 -np 8 \
    --host 127.0.0.1 --port "$port" -lv 1 >"$out/server.log" 2>&1 &
server_pid=$!
cleanup() {
    kill -INT "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

ready=false
for _ in $(seq 1 180); do
    kill -0 "$server_pid" 2>/dev/null || { echo "server exited during startup" >&2; exit 1; }
    if curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done
[ "$ready" = true ] || { echo "server readiness timeout" >&2; exit 1; }
kill -0 "$server_pid" 2>/dev/null || { echo "server exited after readiness (port collision?)" >&2; exit 1; }

for concurrency in 4 1 2 8; do
    node "$root/scripts/bench-gemma4-rust-code.mjs" "http://127.0.0.1:$port" \
        "$out/c${concurrency}.jsonl" "$tasks" 128 16 "$concurrency" 1
done

cleanup
trap - EXIT INT TERM
tail -1 "$out/server.log"
