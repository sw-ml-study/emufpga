#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source_dir="$repo_dir/visualization"
output_dir="$repo_dir/pages"

mkdir -p "$output_dir"
find "$output_dir" -mindepth 1 -maxdepth 1 -type f -delete
cp "$source_dir/index.html" "$source_dir/how.html" "$source_dir/experiments.html" \
    "$source_dir/results.html" "$source_dir/hypothesis.html" "$source_dir/lab.html" \
    "$output_dir/"
cp "$source_dir/notebook.js" "$output_dir/notebook.js"
cp "$source_dir/notebook.css" "$output_dir/notebook.css"
cp "$source_dir/app.js" "$output_dir/app.js"
cp "$source_dir/style.css" "$output_dir/style.css"
cp "$source_dir/analysis.css" "$output_dir/analysis.css"
cp "$source_dir/economics.js" "$output_dir/economics.js"
cp "$source_dir/architectures.js" "$output_dir/architectures.js"
cp "$repo_dir/docs/data/granite-routing-analysis.json" "$output_dir/routing-analysis.json"
cp "$repo_dir/docs/data/granite-timing.json" "$output_dir/granite-timing.json"
cp "$repo_dir/docs/data/storage-tier-analysis.json" "$output_dir/storage-tier-analysis.json"
cp "$repo_dir/docs/data/prefetch-analysis.json" "$output_dir/prefetch-analysis.json"
touch "$output_dir/.nojekyll"

build_host=$(hostname -s)
build_sha=$(git -C "$repo_dir" rev-parse --short=12 HEAD)
build_timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"host":"%s","sha":"%s","timestamp":"%s"}\n' \
    "$build_host" "$build_sha" "$build_timestamp" > "$output_dir/build-info.json"

echo "Built static Pages site in $output_dir"
echo "To publish: commit pages/ on main, then run scripts/deploy-pages"
