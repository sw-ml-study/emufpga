#!/usr/bin/env bash
set -euo pipefail

llama_dir=${LLAMA_CPP_DIR:-/disk1/github/ggml-org/llama.cpp}
if [[ -n "${LLAMA_CPP_BUILD_DIR:-}" ]]; then
    build_dir=$LLAMA_CPP_BUILD_DIR
elif [[ -d /disk1/tmp/llama.cpp-sm120-build ]]; then
    build_dir=/disk1/tmp/llama.cpp-sm120-build
else
    build_dir=$llama_dir/build
fi
model=${1:?usage: scripts/llama-logits-oracle MODEL.gguf PROMPT}
prompt=${2:?usage: scripts/llama-logits-oracle MODEL.gguf PROMPT}
expected=6e6725459a892b49602b596339de4916c7c7965a
actual=$(git -C "$llama_dir" rev-parse HEAD)
if [[ "$actual" != "$expected" ]]; then
    echo "llama.cpp revision mismatch: expected $expected, found $actual" >&2
    exit 1
fi

build_name=${build_dir##*/}
binary=/disk1/tmp/emufpga-llama-logits-$expected-$build_name
if [[ ! -x "$binary" || tools/llama-logits/main.cpp -nt "$binary" ]]; then
    if [[ -f "$build_dir/bin/libllama.so" ]]; then
        c++ -std=c++20 -O2 \
            -I"$llama_dir/include" -I"$llama_dir/ggml/include" \
            tools/llama-logits/main.cpp -o "$binary" \
            -L"$build_dir/bin" -Wl,-rpath,"$build_dir/bin" \
            -lllama -lggml -lggml-base
    else
        c++ -std=c++20 -O2 \
            -I"$llama_dir/include" -I"$llama_dir/ggml/include" \
            tools/llama-logits/main.cpp -o "$binary" \
            "$build_dir/src/libllama.a" \
            "$build_dir/ggml/src/libggml.a" \
            "$build_dir/ggml/src/libggml-cpu.a" \
            /usr/lib/libgomp.so /usr/lib/libpthread.a \
            "$build_dir/ggml/src/ggml-cuda/libggml-cuda.a" \
            "$build_dir/ggml/src/libggml-base.a" \
            -L/usr/local/lib/ollama/cuda_v12 \
            -Wl,-rpath,/usr/local/lib/ollama/cuda_v12 \
            -l:libcudart.so.12 -l:libcublas.so.12 -l:libcublasLt.so.12 \
            /opt/cuda/targets/x86_64-linux/lib/libculibos.a -lcuda -ldl -lrt -lm
    fi
fi

export LD_LIBRARY_PATH=$build_dir/bin:/usr/local/lib/ollama/cuda_v12:${LD_LIBRARY_PATH:-}
exec "$binary" "$model" "$prompt"
