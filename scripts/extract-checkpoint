#!/usr/bin/env bash
set -euo pipefail

# Rust-native framework checkpoint extraction. Cargo is routed through
# serial.sh because every component shares target/. The former Python
# implementation remains at tools/checkpoint-oracle/extract.py solely
# for independent parity checks.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "$ROOT/scripts/serial.sh" cargo run --quiet --release \
    --manifest-path "$ROOT/components/cli/Cargo.toml" \
    -p spm-extract -- "$@"
