#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
scratch=${SPM_SCRATCH:-/disk1/tmp}
model=${1:-$scratch/granite-3.1-1b-a400m-q6/granite-3.1-1b-a400m-instruct-Q6_K.gguf}
reference=${2:-$scratch/granite-moe-oracle-hello}
export SPM_GRANITE_REFERENCE_DIR=$reference
export SPM_GRANITE_LOGITS_GOLDEN=$root/components/cli/crates/spm-granite-moe/tests/golden/hello-logits.txt
export SPM_GRANITE_SPM_PATH=${SPM_GRANITE_SPM_PATH:-$scratch/granite-moe-block0.spm}
export SPM_GRANITE_ALL_EXPERTS=${SPM_GRANITE_ALL_EXPERTS:-1}
exec "$root/scripts/serial.sh" cargo run --quiet --release \
    --manifest-path "$root/components/cli/Cargo.toml" \
    -p spm-granite-moe -- "$model" 8279
