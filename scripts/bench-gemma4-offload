#!/usr/bin/env bash
set -euo pipefail

# Independent-request baseline for the pinned oversized Gemma-4 MoE. Raw
# responses and telemetry remain outside Git; derived results may be checked in.

root=$(cd "$(dirname "$0")/.." && pwd)
scratch=${SPM_SCRATCH:-/disk1/tmp}
src=${SPM_SRC:-/disk1/github}
arch=$("$root/scripts/cuda-arch.sh")
source_dir=${LLAMA_SOURCE:-$src/ggml-org/llama.cpp}
model=${GEMMA4_MODEL:-$scratch/gemma-4-26b-a4b/google_gemma-4-26B-A4B-it-Q5_K_M.gguf}
tasks=${TASKS:-$root/docs/data/gemma4-correctness-tasks.json}
client=${CLIENT:-$root/scripts/bench-gemma4-requests.mjs}
out=${1:-$scratch/emufpga-gemma4-$(date -u +%Y%m%dT%H%M%SZ)}
build=${LLAMA_BUILD:-$scratch/llama.cpp-sm${arch}-build}
server=$build/bin/llama-server
cpu_library=$(readlink -f "$build/bin/libggml-cpu.so")
port=${PORT:-8091}
runs=${RUNS:-3}
prompt_tokens=${PROMPT_TOKENS:-128}
output_tokens=${OUTPUT_TOKENS:-16}
concurrencies=${CONCURRENCIES:-1,2,4,8}
gpu_layers=${GPU_LAYERS:-20}
placement=${PLACEMENT:-layer-offload}
lazy_mode=${LAZY_MODE:-off}
expected_sha=6b4f8074239f72543997a950ff6ae4509553c599f5b432748309ff3438416493
expert_reclaim=false
cache_plan=${CACHE_PLAN:-}
cache_before_load=${CACHE_BEFORE_LOAD:-untouched}
warmup=${WARMUP:-on}
[ -n "${GGML_MUL_MAT_ID_DONTNEED:-}" ] && expert_reclaim=true

for value in "$runs" "$prompt_tokens" "$output_tokens" "$gpu_layers"; do
    case "$value" in ''|*[!0-9]*) echo "counts must be nonnegative integers" >&2; exit 2 ;; esac
done
[ "$runs" -gt 0 ] && [ "$prompt_tokens" -gt 0 ] && [ "$output_tokens" -gt 0 ] || {
    echo "run and token counts must be positive" >&2
    exit 2
}
[ -x "$server" ] || { echo "missing llama-server: $server" >&2; exit 2; }
[ -f "$cpu_library" ] || { echo "missing llama CPU library: $cpu_library" >&2; exit 2; }
[ -f "$model" ] || { echo "missing Gemma-4 model: $model" >&2; exit 2; }
[ -f "$tasks" ] || { echo "missing task corpus: $tasks" >&2; exit 2; }
[ -f "$client" ] || { echo "missing request client: $client" >&2; exit 2; }
command -v ss >/dev/null || { echo "missing required tool: ss" >&2; exit 2; }
nvidia-smi >/dev/null || { echo "NVIDIA device unavailable" >&2; exit 2; }
if ss -H -ltn "sport = :$port" | rg -q .; then
    echo "benchmark port already occupied: 127.0.0.1:$port" >&2
    exit 2
fi
actual_sha=$(sha256sum "$model" | awk '{print $1}')
[ "$actual_sha" = "$expected_sha" ] || { echo "Gemma-4 SHA-256 mismatch: $actual_sha" >&2; exit 2; }
server_sha=$(sha256sum "$server" | awk '{print $1}')
cpu_library_sha=$(sha256sum "$cpu_library" | awk '{print $1}')

mkdir -p "$out"
revision=$(git -C "$source_dir" rev-parse HEAD)
model_source=$(findmnt -n -o SOURCE -T "$model")
model_target=$(findmnt -n -o TARGET -T "$model")
model_fstype=$(findmnt -n -o FSTYPE -T "$model")
model_identity=$(stat -c '%d:%i:%s' "$model")
model_device=${model_source%%[*}
model_partition=$(lsblk -n -o KNAME "$model_device")
device_stat=/sys/class/block/$model_partition/stat
[ -r "$device_stat" ] || { echo "missing device statistics: $device_stat" >&2; exit 2; }
[ -x "$root/target/release/spm-file-residency" ] || {
    (cd "$root/components/cli" && "$root/scripts/serial.sh" cargo build --release -p spm-file-residency)
}
if [ -n "$cache_plan" ]; then
    IFS=, read -ra cache_values <<<"$cache_plan"
    [ "${#cache_values[@]}" -eq "$runs" ] || {
        echo "CACHE_PLAN must contain exactly RUNS entries" >&2
        exit 2
    }
    for cache_value in "${cache_values[@]}"; do
        case "$cache_value" in cold|warm) ;; *) echo "invalid CACHE_PLAN: $cache_plan" >&2; exit 2 ;; esac
    done
fi
case "$cache_before_load" in cold|warm|untouched) ;; *) echo "invalid CACHE_BEFORE_LOAD: $cache_before_load" >&2; exit 2 ;; esac
case "$warmup" in on) warmup_args=() ;; off) warmup_args=(--no-warmup) ;; *) echo "invalid WARMUP: $warmup" >&2; exit 2 ;; esac
case "$placement" in
    layer-offload) override=() ;;
    experts-cpu) override=(-ot '.*ffn_.*_exps\.weight=CPU') ;;
    *) echo "unknown PLACEMENT: $placement" >&2; exit 2 ;;
esac
printf '{"schema":"emufpga.gemma4-offload.v1","model":"%s","model_path":"%s","sha256":"%s","model_identity":"%s","model_source":"%s","model_mount":"%s","model_fstype":"%s","model_device_stat":"%s","llama_revision":"%s","llama_build":"%s","server_sha256":"%s","cpu_library_sha256":"%s","placement":"%s","lazy_mode":"%s","expert_reclaim":%s,"warmup":"%s","cache_before_load":"%s","cache_plan":"%s","gpu_layers":%s,"prompt_tokens":%s,"output_tokens":%s,"runs":%s,"tasks":"%s","client":"%s","energy_scope":"NVIDIA board only; not whole system"}\n' \
    "$(basename "$model")" "$model" "$actual_sha" "$model_identity" "$model_source" "$model_target" "$model_fstype" "$device_stat" "$revision" "$build" "$server_sha" "$cpu_library_sha" "$placement" "$lazy_mode" "$expert_reclaim" "$warmup" "$cache_before_load" "$cache_plan" "$gpu_layers" "$prompt_tokens" "$output_tokens" "$runs" "$(basename "$tasks")" "$(basename "$client")" >"$out/manifest.json"

if [ "$cache_before_load" = cold ]; then
    "$root/scripts/gemma4-file-residency" evict >"$out/cache-before-load.json"
else
    "$root/target/release/spm-file-residency" status "$model" >"$out/cache-before-load.json"
fi
startup_started=$(date +%s.%N)
startup_read_ios_before=$(awk '{print $1}' "$device_stat")
startup_sectors_before=$(awk '{print $3}' "$device_stat")

"$server" -m "$model" -ngl "$gpu_layers" "${override[@]}" --lazy-mode "$lazy_mode" "${warmup_args[@]}" -c 4096 -np 8 \
    --host 127.0.0.1 --port "$port" -lv 1 >"$out/server.log" 2>&1 &
server_pid=$!
cleanup() {
    kill "${sampler_pid:-}" "$server_pid" 2>/dev/null || true
    wait "${sampler_pid:-}" "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

server_ready=false
for _ in $(seq 1 180); do
    kill -0 "$server_pid" 2>/dev/null || { echo "llama-server exited during load" >&2; exit 1; }
    if curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
        server_ready=true
        break
    fi
    sleep 1
done
[ "$server_ready" = true ] || { echo "llama-server not ready" >&2; exit 1; }
kill -0 "$server_pid" 2>/dev/null || { echo "llama-server exited after readiness" >&2; exit 1; }
startup_ended=$(date +%s.%N)
startup_read_ios_after=$(awk '{print $1}' "$device_stat")
startup_sectors_after=$(awk '{print $3}' "$device_stat")
startup_read_bytes=$(awk '/^read_bytes:/{print $2}' "/proc/$server_pid/io")
read -r startup_minor_faults startup_major_faults < <(awk '{print $10, $12}' "/proc/$server_pid/stat")
startup_residency=$("$root/target/release/spm-file-residency" status "$model")
printf '{"schema":"emufpga.gemma4-startup-io.v1","started_s":%s,"ended_s":%s,"cache_before_load":"%s","server_read_bytes":%s,"minor_faults":%s,"major_faults":%s,"device_read_ios_delta":%s,"device_read_sectors_delta":%s,"sector_bytes":512,"residency_before":%s,"residency_after":%s}\n' \
    "$startup_started" "$startup_ended" "$cache_before_load" "$startup_read_bytes" "$startup_minor_faults" "$startup_major_faults" "$((startup_read_ios_after - startup_read_ios_before))" "$((startup_sectors_after - startup_sectors_before))" \
    "$(cat "$out/cache-before-load.json")" "$startup_residency" >"$out/startup-io.json"

(
    printf 'timestamp_s,rss_kib,rss_anon_kib,rss_file_kib,pss_kib,pss_anon_kib,pss_file_kib,read_bytes,rchar,gpu_memory_mib,gpu_util_percent,gpu_power_w\n'
    while kill -0 "$server_pid" 2>/dev/null; do
        stamp=$(date +%s.%N)
        gpu=$(nvidia-smi --query-gpu=memory.used,utilization.gpu,power.draw --format=csv,noheader,nounits)
        rss=$(awk '/^VmRSS:/{print $2}' "/proc/$server_pid/status" 2>/dev/null || true)
        rss_anon=$(awk '/^RssAnon:/{print $2}' "/proc/$server_pid/status" 2>/dev/null || true)
        rss_file=$(awk '/^RssFile:/{print $2}' "/proc/$server_pid/status" 2>/dev/null || true)
        pss=$(awk '/^Pss:/{print $2}' "/proc/$server_pid/smaps_rollup" 2>/dev/null || true)
        pss_anon=$(awk '/^Pss_Anon:/{print $2}' "/proc/$server_pid/smaps_rollup" 2>/dev/null || true)
        pss_file=$(awk '/^Pss_File:/{print $2}' "/proc/$server_pid/smaps_rollup" 2>/dev/null || true)
        read_bytes=$(awk '/^read_bytes:/{print $2}' "/proc/$server_pid/io" 2>/dev/null || true)
        rchar=$(awk '/^rchar:/{print $2}' "/proc/$server_pid/io" 2>/dev/null || true)
        printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$stamp" "${rss:-0}" "${rss_anon:-0}" \
            "${rss_file:-0}" "${pss:-0}" "${pss_anon:-0}" "${pss_file:-0}" \
            "${read_bytes:-0}" "${rchar:-0}" "$gpu"
        sleep 0.2
    done
) >"$out/telemetry.csv" &
sampler_pid=$!

: >"$out/summaries.jsonl"
: >"$out/io-snapshots.jsonl"
printf 'timestamp_s,concurrency,event\n' >"$out/phases.csv"
IFS=, read -ra concurrency_values <<<"$concurrencies"
for concurrency in "${concurrency_values[@]}"; do
    case "$concurrency" in ''|*[!0-9]*) echo "invalid CONCURRENCIES: $concurrencies" >&2; exit 2 ;; esac
    printf '%s,%s,start\n' "$(date +%s.%N)" "$concurrency" >>"$out/phases.csv"
    SERVER_PID=$server_pid GEMMA4_MODEL=$model MODEL_DEVICE_STAT=$device_stat \
        CACHE_PLAN=$cache_plan TRIAL_METRICS=$out/io-snapshots.jsonl \
        RESIDENCY_TOOL=$root/target/release/spm-file-residency \
        CACHE_EVICT_TOOL=$root/scripts/gemma4-file-residency \
        node "$client" "http://127.0.0.1:$port" \
        "$out/requests-$concurrency.jsonl" "$tasks" \
        "$prompt_tokens" "$output_tokens" "$concurrency" "$runs" >>"$out/summaries.jsonl"
    printf '%s,%s,end\n' "$(date +%s.%N)" "$concurrency" >>"$out/phases.csv"
done

echo "results: $out"
jq -s . "$out/summaries.jsonl"
